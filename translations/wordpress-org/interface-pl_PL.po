msgid "Bible Desktop returned HTTP error %d."
msgstr "Bible Desktop zwrócił błąd HTTP %d."

msgid "The translation service is temporarily unavailable."
msgstr "Usługa tłumaczenia jest tymczasowo niedostępna."

msgid "The translation request limit has been reached. Please try again later."
msgstr "Osiągnięto limit żądań tłumaczenia. Spróbuj ponownie później."

msgid "Check the entered text and translation settings."
msgstr "Sprawdź wprowadzony tekst i ustawienia tłumaczenia."

msgid "The Bible Desktop API key is invalid."
msgstr "Klucz API Bible Desktop jest nieprawidłowy."

msgid "The free daily limit has been reached. Add an API key for higher limits or try again after the reset."
msgstr "Osiągnięto bezpłatny limit dzienny. Dodaj klucz API, aby zwiększyć limity, lub spróbuj ponownie po ich zresetowaniu."

msgid "The higher translation limit has been reached. Please try again later."
msgstr "Osiągnięto podwyższony limit tłumaczeń. Spróbuj ponownie później."

msgid "Could not connect to Bible Desktop."
msgstr "Nie udało się połączyć z Bible Desktop."

msgid "The text is too long."
msgstr "Tekst jest zbyt długi."

msgid "The selected source language is not supported."
msgstr "Wybrany język źródłowy nie jest obsługiwany."

msgid "Enter text to translate."
msgstr "Wprowadź tekst do przetłumaczenia."

msgid "After downloading, open MonomakhUnicode.ttf and click Install. If Word does not select it automatically, select the pasted text and assign Monomakh Unicode manually."
msgstr "Po pobraniu otwórz MonomakhUnicode.ttf i kliknij Zainstaluj. Jeśli Word nie wybierze czcionki automatycznie, zaznacz wklejony tekst i ręcznie przypisz Monomakh Unicode."

